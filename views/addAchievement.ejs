<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Add Achievement</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="navbar">
    <div class="navbar-brand"><a href="/">Enrichment Passport</a></div>
    <div class="navbar-menu">
      <a href="/">Home</a>
      <a href="/dashboard">Dashboard</a>
      <a href="/profile">Profile</a>
      <a href="/logout">Logout</a>
    </div>
    <div class="navbar-action"><a href="/logout" class="button">Logout</a></div>
  </header>

  <main class="container">
    <div class="content-card">
      <h1>Add Achievement</h1>
      <p class="small-text">Add a new achievement to your profile and progress toward the next badge.</p>
      <form action="/add" method="POST" enctype="multipart/form-data" class="form-row" style="margin-top:1rem;">
        <label for="title">Achievement title</label>
        <input type="text" id="title" name="title" placeholder="Enter achievement title" required>
        <label for="attachment">Certificate image / document</label>
        <input type="file" id="attachment" name="attachment" accept="image/*,application/pdf,.doc,.docx">
        <small class="small-text">Optional: upload supporting certificate proof as an image or document.</small>
        <button type="submit">Add Achievement</button>
      </form>
      <p style="margin-top:1rem;"><a href="/dashboard">Back to Dashboard</a></p>
    </div>
  </main>
</body>
</html>
