<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Dashboard</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <header class="navbar">
    <div class="navbar-brand"><a href="/">Enrichment Passport</a></div>
    <div class="navbar-menu">
      <a href="/"><i class="fas fa-home"></i> Home</a>
      <a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
      <a href="/add"><i class="fas fa-plus"></i> Add Achievement</a>
      <a href="/profile"><i class="fas fa-user"></i> Profile</a>
      <% if (!isGuest) { %>
        <a href="/certificate"><i class="fas fa-file-certificate"></i> Certificate</a>
      <% } %>
      <a href="/leaderboard"><i class="fas fa-trophy"></i> Leaderboard</a>
    </div>
    <div class="navbar-action"><a href="/logout" class="button"><i class="fas fa-sign-out-alt"></i> Logout</a></div>
  </header>

  <main class="container">
    <section class="hero content-card">
      <div>
        <span class="badge-pill"><%= isGuest ? 'Dashboard overview' : 'Personal dashboard' %></span>
        <h1><%= isGuest ? 'Welcome to the Enrichment Dashboard' : `Welcome back, ${username}` %></h1>
        <p class="lead"><%= isGuest ? 'Explore overall achievement progress and sign in to manage your own milestones.' : 'Track your most recent achievements, monitor badge progress and see the metrics that matter for your Level 6 portfolio.' %></p>
      </div>
      <div style="display:flex; flex-wrap:wrap; gap:0.75rem; justify-content:flex-end; align-items:center;">
        <% if (isGuest) { %>
          <a class="button" href="/login"><i class="fas fa-sign-in-alt"></i> Login</a>
          <a class="button button-secondary" href="/register"><i class="fas fa-user-plus"></i> Register</a>
        <% } else { %>
          <a class="button" href="/add"><i class="fas fa-plus"></i> Add achievement</a>
          <a class="button button-secondary" href="/profile"><i class="fas fa-user"></i> View profile</a>
          <a class="button button-secondary" href="/certificate/preview"><i class="fas fa-file-certificate"></i> View certificate</a>
        <% } %>
      </div>
    </section>

    <div class="stats-grid">
      <div class="grid-card">
        <h3><i class="fas fa-trophy"></i> <%= isGuest ? 'Total achievements tracked' : 'My achievements' %></h3>
        <p><%= isGuest ? totalAchievements : achievementCount %></p>
      </div>
      <div class="grid-card">
        <h3><i class="fas fa-medal"></i> Current tier</h3>
        <p><%= currentTier %></p>
        <span class="badge-pill"><img src="<%= overallBadge %>" alt="Badge"><%= currentTier %></span>
      </div>
      <div class="grid-card">
        <h3><i class="fas fa-calendar"></i> Active days</h3>
        <p><%= activeDays %></p>
      </div>
      <div class="grid-card">
        <h3><i class="fas fa-chart-line"></i> Average per week</h3>
        <p><%= averagePerWeek %></p>
      </div>
    </div>

    <div class="content-card">
      <h2>Progress summary</h2>
      <p class="small-text"><%= isGuest ? 'Browse the site and sign in to start tracking your own badge progress.' : 'Your current progress toward the next badge tier.' %></p>
      <div class="progress-bar" style="margin-top:0.9rem;"><span style="width:<%= Math.round(progress * 100) %>%;"></span></div>
      <% if (isGuest) { %>
        <p style="margin-top:1rem;"><strong><%= Math.round(progress * 100) %>%</strong> progress for the default starter tier. <a href="/login">Login</a> to make this dashboard your own.</p>
      <% } else if(nextTier) { %>
        <p style="margin-top:1rem;"><strong><%= Math.round(progress * 100) %>%</strong> toward unlocking <strong><%= nextTier %></strong>. <%= Math.max(nextCount - achievementCount, 0) %> more achievements needed.</p>
      <% } else { %>
        <p style="margin-top:1rem;"><strong>You've reached Gold.</strong> Keep adding achievements to maintain your position.</p>
      <% } %>
    </div>

    <div class="section-grid">
      <div class="content-card">
        <h2>Recent achievements</h2>
        <ul class="activity-list">
          <% if(recentAchievements.length === 0) { %>
            <li><strong>No achievements yet.</strong> Add one to start building your profile.</li>
          <% } %>
          <% recentAchievements.forEach(a => { %>
            <li>
              <span style="display:grid; gap:0.35rem;">
                <strong><%= a.title %></strong>
                <small><%= a.dateLabel %></small>
                <% if (a.attachment) { %>
                  <a href="<%= a.attachment %>" target="_blank">View attachment</a>
                <% } %>
              </span>
              <span class="badge-pill"><img src="<%= a.badge %>" alt="Badge"><%= a.badge.includes('gold') ? 'Gold' : a.badge.includes('silver') ? 'Silver' : 'Bronze' %></span>
            </li>
          <% }) %>
        </ul>
      </div>
      <div class="content-card">
        <h2>Badge insight</h2>
        <p class="small-text">Badges are a quick visual signal of your progress. They help you present achievement milestones clearly in a final-year submission.</p>
        <div style="display:flex; gap:1rem; flex-wrap:wrap; align-items:center; margin-top:1rem;">
          <img src="<%= overallBadge %>" alt="Badge" width="120">
          <div>
            <p><strong>Tier:</strong> <%= currentTier %></p>
            <% if(nextTier) { %>
              <p><strong>Next tier:</strong> <%= nextTier %></p>
              <p><strong>Target:</strong> <%= nextCount %> achievements</p>
            <% } %>
          </div>
        </div>
        <p class="footer-note" style="margin-top:1rem;">Designed for clarity with strong visual hierarchy, consistent spacing and an intuitive student experience.</p>
      </div>
    </div>
  </main>
  
  
</body>
</html>
