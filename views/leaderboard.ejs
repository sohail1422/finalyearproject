<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Leaderboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="navbar">
    <div class="navbar-brand"><a href="/">Enrichment Passport</a></div>
    <div class="navbar-menu">
      <a href="/">Home</a>
      <a href="/dashboard">Dashboard</a>
      <a href="/add">Add Achievement</a>
      <a href="/profile">My Profile</a>
      <a href="/logout">Logout</a>
    </div>
    <div class="navbar-action"><a href="/logout" class="button">Logout</a></div>
  </header>

  <main class="container">
    <div class="content-card">
      <h1>Leaderboard</h1>
      <div class="table-responsive" style="margin-top:1rem;">
        <table>
          <thead>
            <tr>
              <th>Rank</th>
              <th>User</th>
              <th>Achievements</th>
              <th>Tier</th>
              <th>Badge</th>
            </tr>
          </thead>
          <tbody>
            <% ranking.forEach((item, idx) => { %>
              <tr>
                <td><%= idx + 1 %></td>
                <td><%= item.username %></td>
                <td><%= item.count %></td>
                <td><%= item.tier %></td>
                <td><img src="<%= item.badge %>" width="26" alt="<%= item.tier %>"></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p style="margin-top:1rem;"><a href="/dashboard">Back to Dashboard</a></p>
    </div>
  </main>
</body>
</html>
