<!DOCTYPE html>
<html>
<head>
  <title>Leaderboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="navbar">
    <div class="navbar-brand"><a href="/">Enrichment Passport</a></div>
    <div class="navbar-menu">
      <a href="/">Home</a>
      <a href="/dashboard">Dashboard</a>
      <a href="/add">Add Achievement</a>
      <a href="/profile">My Profile</a>
      <a href="/logout">Logout</a>
    </div>
    <div class="navbar-action"><a href="/logout" class="button">Logout</a></div>
  </header>

  <main class="container">
    <div class="content-card">
      <h1>Leaderboard</h1>
      <table style="width:100%; border-collapse: collapse; margin-top: 1rem;">
        <thead>
          <tr>
            <th style="text-align:left; border-bottom: 1px solid #CBD5E1; padding: 8px;">Rank</th>
            <th style="text-align:left; border-bottom: 1px solid #CBD5E1; padding: 8px;">User</th>
            <th style="text-align:left; border-bottom: 1px solid #CBD5E1; padding: 8px;">Achievements</th>
            <th style="text-align:left; border-bottom: 1px solid #CBD5E1; padding: 8px;">Tier</th>
            <th style="text-align:left; border-bottom: 1px solid #CBD5E1; padding: 8px;">Badge</th>
          </tr>
        </thead>
        <tbody>
          <% ranking.forEach((item, idx) => { %>
            <tr>
              <td style="padding: 8px; border-bottom: 1px solid #E5E7EB;"><%= idx + 1 %></td>
              <td style="padding: 8px; border-bottom: 1px solid #E5E7EB;"><%= item.username %></td>
              <td style="padding: 8px; border-bottom: 1px solid #E5E7EB;"><%= item.count %></td>
              <td style="padding: 8px; border-bottom: 1px solid #E5E7EB;"><%= item.tier %></td>
              <td style="padding: 8px; border-bottom: 1px solid #E5E7EB;"><img src="<%= item.badge %>" width="26" alt="<%= item.tier %>"></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p><a href="/dashboard">Back to Dashboard</a></p>
    </div>
  </main>
</body>
</html>