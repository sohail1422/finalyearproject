<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Profile</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <header class="navbar">
    <div class="navbar-brand"><a href="/">Enrichment Passport</a></div>
    <div class="navbar-menu">
      <a href="/"><i class="fas fa-home"></i> Home</a>
      <a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
      <a href="/add"><i class="fas fa-plus"></i> Add Achievement</a>
      <a href="/leaderboard"><i class="fas fa-trophy"></i> Leaderboard</a>
      <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>
    <div class="navbar-action"><a href="/logout" class="button"><i class="fas fa-sign-out-alt"></i> Logout</a></div>
  </header>

  <main class="container">
    <div class="hero content-card">
      <div style="display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
        <img src="<%= avatar %>" alt="Avatar" width="96" height="96" style="border-radius:50%; border:2px solid #2563EB;">
        <div>
          <h1><%= username %></h1>
          <p class="small-text"><strong>Name:</strong> <%= username %></p>
          <p class="small-text"><strong>Bio:</strong> <%= bio || "No bio yet." %></p>
        </div>
      </div>
    </div>

    <div class="stats-grid">
      <div class="grid-card">
        <h3>Total achievements</h3>
        <p><%= achievementCount %></p>
      </div>
      <div class="grid-card">
        <h3>Current tier</h3>
        <p><%= tierInfo.tier %></p>
      </div>
      <div class="grid-card">
        <h3>Average per week</h3>
        <p><%= averagePerWeek %></p>
      </div>
      <div class="grid-card">
        <h3>Profile actions</h3>
        <p><a href="/profile/edit">Edit profile</a></p>
        <p style="margin-top:0.75rem;"><a href="/logout" class="button button-secondary"><i class="fas fa-sign-out-alt"></i> Logout</a></p>
      </div>
    </div>

    <div class="content-card">
      <h2>Achievements history</h2>
      <% if(achievements.length === 0) { %>
        <p>No achievements yet. Start by adding one.</p>
      <% } else { %>
        <ul class="activity-list">
          <% achievements.forEach(a => {
              const dateValue = a.createdAt ? new Date(a.createdAt) : null;
              const dateLabel = dateValue && !isNaN(dateValue.valueOf()) ? dateValue.toLocaleDateString() : 'Not available';
            %>
            <li style="flex-direction:column; align-items:flex-start; gap:0.75rem;">
              <div style="width:100%; display:flex; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
                <span>
                  <strong><%= a.title %></strong><br>
                  <small><%= dateLabel %></small>
                </span>
                <span class="badge-pill"><img src="<%= a.badge %>" alt="Badge"><%= a.badge.includes('gold') ? 'Gold' : a.badge.includes('silver') ? 'Silver' : 'Bronze' %></span>
              </div>
              <% if (a.attachment) { %>
                <a href="<%= a.attachment %>" target="_blank">View supporting certificate</a>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="content-card" style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
      <div>
        <h2>Your badge</h2>
        <p class="small-text">Keep your profile current and add achievements often to maintain progress.</p>
      </div>
      <img src="<%= tierInfo.badge %>" alt="Tier badge" width="92">
    </div>

    <div class="content-card">
      <p><a href="/dashboard">Back to Dashboard</a></p>
    </div>
  </main>
</body>
</html>
