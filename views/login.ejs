<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Login</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="navbar">
    <div class="navbar-brand"><a href="/">Enrichment Passport</a></div>
    <div class="navbar-menu">
      <a href="/">Home</a>
      <a href="/register">Register</a>
    </div>
  </header>

  <main class="container">
    <div class="content-card">
      <h1>Login</h1>
      <p class="small-text">Access your account, add achievements, and track your progress.</p>
      <form action="/login" method="POST" class="form-row" style="margin-top:1rem;">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="Username" required>
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Password" required>
        <button type="submit">Login</button>
      </form>
      <% if (message) { %>
        <p style="color:#dc2626; margin-top:1rem;"><%= message %></p>
      <% } %>
      <p style="margin-top:1.25rem;">Need an account? <a href="/register">Register</a></p>
      <p><a href="/">Back to Home</a></p>
    </div>
  </main>
</body>
</html>
